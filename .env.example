# House of Chairs, environment variables.
# Copy to .env.local and fill in. The public keys below are safe to expose to
# the browser; the service role key and admin password must stay server-side.

# Supabase, public catalogue read (browser and server, anon role under RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role, used only by the /api/admin server routes to manage
# the collection. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Owner dashboard sign-in (username and password gate).
ADMIN_USER=
ADMIN_PASSWORD=
# Optional: a separate secret to sign the session cookie. Falls back to the
# password when unset.
ADMIN_SESSION_SECRET=

# Owner email notifications, sent from the sales@ mailbox through Easily's
# mail server with the buyer as Reply-To (optional). Enquiries and interest
# are still stored without these; only the email is skipped. Server-only and
# sensitive: never prefix NEXT_PUBLIC_. Only the password is required.
HOC_SMTP_PASSWORD=
# HOC_SMTP_USER=sales@houseofchairs.co.uk
# HOC_SMTP_HOST=smtp.easily.uk
# HOC_SMTP_PORT=465
# HOC_NOTIFY_TO=sales@houseofchairs.co.uk

# Cloudflare Turnstile bot check on the enquiry, interest and mailing list
# forms (optional). Create a widget at dash.cloudflare.com > Turnstile for
# houseofchairs.co.uk (mode: managed). Set BOTH together: a secret without the
# site key turns every form away. With neither, the forms work as before.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
